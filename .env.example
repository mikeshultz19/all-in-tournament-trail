NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must exactly match the HTTPS notification URL configured in Square.
SQUARE_WEBHOOK_NOTIFICATION_URL=

# Registration opens only when this is true and Supabase is AITT-Staging.

# Server-side confirmation email. Staging requires an explicit recipient allowlist.
RESEND_API_KEY=
AITT_EMAIL_ENVIRONMENT=
AITT_STAGING_EMAIL_ALLOWLIST=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local development belongs in .env.local (AITT-Staging).
# Production deployment values belong in the Git-ignored
# .env.production.local file and are validated by npm run deploy:check.
